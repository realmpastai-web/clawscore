{
  "name": "clawscore",
  "version": "0.1.0",
  "description": "One command. A 0-100 security score for your OpenClaw setup, and the fixes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clawscore": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "schemas",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/setup-fixtures.mjs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realmpastai-web/clawscore.git"
  },
  "bugs": {
    "url": "https://github.com/realmpastai-web/clawscore/issues"
  },
  "homepage": "https://github.com/realmpastai-web/clawscore#readme",
  "keywords": [
    "openclaw",
    "clawdbot",
    "security",
    "audit",
    "cli",
    "score"
  ],
  "devDependencies": {
    "@types/node": "^20.17.12",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
