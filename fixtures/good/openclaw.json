{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "oc_gw_fixture_token_not_a_secret_aa"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["http://127.0.0.1:18789", "http://localhost:18789"],
      "dangerouslyAllowHostHeaderOriginFallback": false
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "sandbox": {
        "mode": "non-main",
        "backend": "docker",
        "scope": "session"
      }
    }
  },
  "tools": {
    "exec": {
      "mode": "allowlist",
      "allowlist": ["/usr/bin/echo", "/usr/bin/uname"],
      "safeBins": ["echo"]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["123456789"]
    }
  },
  "skills": {
    "entries": {
      "weather": {
        "enabled": true,
        "apiKey": { "source": "env", "provider": "default", "id": "WEATHER_API_KEY" }
      }
    }
  }
}
